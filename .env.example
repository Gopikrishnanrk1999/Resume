# Content Delivery API — read-only token used by the deployed site
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# Content Management API — only needed locally to run `npm run seed`
CONTENTFUL_MANAGEMENT_TOKEN=

# Shared secret for the /api/revalidate webhook (make up any random string)
CONTENTFUL_REVALIDATE_SECRET=
